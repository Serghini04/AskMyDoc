# Database
POSTGRES_USER=
POSTGRES_PASSWORD=
POSTGRES_DB=
POSTGRES_HOST=postgres
POSTGRES_PORT=5432
DATABASE_URL=postgresql://${POSTGRES_USER}:${POSTGRES_PASSWORD}@postgres:5432/${POSTGRES_DB}

# Qdrant
QDRANT_HOST=qdrant
QDRANT_PORT=6333
QDRANT_URL=http://qdrant:6333
ADMINER_PORT=8080

# LLM — GitHub Models (get token at github.com/settings/tokens)
GITHUB_TOKEN=
GITHUB_MODEL=o4-mini

# Embeddings — fastembed local ONNX (no API key needed)
# bge-small-en-v1.5 = 384 dims | bge-base-en-v1.5 = 768 dims
FASTEMBED_MODEL=BAAI/bge-small-en-v1.5
EMBEDDING_DIMENSIONS=384

# Upload
MAX_UPLOAD_SIZE_MB=50
