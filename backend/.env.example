# Database
POSTGRES_USER=
POSTGRES_PASSWORD=
POSTGRES_DB=
POSTGRES_HOST=postgres
POSTGRES_PORT=5432
DATABASE_URL=postgresql+psycopg2://${POSTGRES_USER}:${POSTGRES_PASSWORD}@postgres:5432/${POSTGRES_DB}

# Qdrant
QDRANT_HOST=qdrant
QDRANT_PORT=6333
QDRANT_URL=http://qdrant:6333
ADMINER_PORT=8080



# Upload
MAX_UPLOAD_SIZE_MB=50

# CORS — comma-separated frontend origins allowed to call the API
CORS_ORIGINS=http://localhost:3000

# AI provider — any OpenAI-compatible API. Default: OpenAI (one key for answers + embeddings).
# Get a key at https://platform.openai.com/api-keys
LLM_BASE_URL=https://api.openai.com/v1
LLM_API_KEY=
LLM_MODEL=gpt-4.1-nano
# OpenRouter only: comma-separated models tried if LLM_MODEL fails. Leave empty for OpenAI.
LLM_FALLBACK_MODELS=

# Embeddings reuse LLM_API_KEY unless EMBEDDING_API_KEY is set.
# Changing the model or dimensions requires: make reindex
EMBEDDING_BASE_URL=https://api.openai.com/v1
EMBEDDING_MODEL=text-embedding-3-small
EMBEDDING_DIMENSIONS=1536
