# Database
POSTGRES_USER=
POSTGRES_PASSWORD=
POSTGRES_DB=
POSTGRES_HOST=postgres
POSTGRES_PORT=5432
DATABASE_URL=postgresql+psycopg2://${POSTGRES_USER}:${POSTGRES_PASSWORD}@postgres:5432/${POSTGRES_DB}

# Qdrant
QDRANT_HOST=qdrant
QDRANT_PORT=6333
QDRANT_URL=http://qdrant:6333
ADMINER_PORT=8080

# LLM — any OpenAI-compatible provider (default: OpenRouter)
# Get a key at https://openrouter.ai/settings/keys
LLM_BASE_URL=https://openrouter.ai/api/v1
LLM_API_KEY=
LLM_MODEL=google/gemma-4-26b-a4b-it:free
# Tried in order if LLM_MODEL fails (OpenRouter only; comma-separated)
LLM_FALLBACK_MODELS=nvidia/nemotron-3-super-120b-a12b:free

# Embeddings — fastembed local ONNX (no API key needed)
# bge-small-en-v1.5 = 384 dims | bge-base-en-v1.5 = 768 dims
FASTEMBED_MODEL=BAAI/bge-small-en-v1.5
EMBEDDING_DIMENSIONS=384

# Upload
MAX_UPLOAD_SIZE_MB=50

# CORS — comma-separated frontend origins allowed to call the API
CORS_ORIGINS=http://localhost:3000
